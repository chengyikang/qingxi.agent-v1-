# QingXi V1 环境配置
# 复制此文件为 .env 并填入你的真实配置

# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://qingxi:qingxi_dev_2026@localhost:5432/qingxi

# ==================== LLM 多提供商配置 ====================
# 支持的提供商（任选其一，取消注释对应行）：
#   openai      — GPT-4o-mini（默认）
#   deepseek    — DeepSeek Chat（中文友好，价格便宜）
#   moonshot    — Moonshot / Kimi
#   zhipu       — 智谱 GLM-4-Flash
#   qwen        — 阿里通义千问 Qwen-Turbo
#   siliconflow — SiliconFlow 聚合平台（多模型可选）
#   custom      — 任意 OpenAI 兼容接口
LLM_PROVIDER=openai

# 通用 API Key（所有提供商通用此字段）
LLM_API_KEY=sk-your-api-key-here

# 可选：覆盖提供商默认 Base URL（仅 custom 或特殊场景需要填写）
# LLM_BASE_URL=https://your-custom-api.com/v1

# 可选：覆盖提供商默认模型名（不填则使用各提供商内置默认模型）
# LLM_MODEL=your-model-name

# 以下字段为向后兼容，设置了 LLM_API_KEY 后可忽略
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ==================== ChromaDB (向量数据库) ====================
CHROMA_PERSIST_DIR=./chroma_data

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000

# ==================== 前端 ====================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=false
